              "value": "={{ (() => { const raw = $json.output; if (raw && typeof raw === 'object') return raw; const t = String(raw ?? ''); const m = t.match(/\\{[\\s\\S]*\\}/); const bad = { intencion: 'SIN_FORMATO', calificacion: '', interesado: {}, resumen: t.slice(0, 300), respuesta_borrador: '', motivo_ruta: 'La salida de Lia no fue un JSON válido' }; if (!m) return bad; try { return JSON.parse(m[0]); } catch (e) { return bad; } })() }}",
